{"text": "Le directeur a parlé de ses projets.", "language": "fr", "glosses": ["AVANT", "DIRECTEUR", "PROJET", "LUI", "PARLER"], "phenomena": ["temps-passe", "possession", "suppression-mot-outil", "verbe-final"]}
{"text": "Nous regardons le match en direct.", "language": "fr", "glosses": ["NOUS", "MATCH", "REGARDER", "DIRECT"], "phenomena": ["lexique-direct", "verbe-final"]}
{"text": "Le concert est diffusé en live.", "language": "fr", "glosses": ["CONCERT", "DIFFUSER", "DIRECT"], "phenomena": ["lexique-direct"]}
{"text": "En conclusion, je vous remercie.", "language": "fr", "glosses": ["ENFIN", "MOI", "REMERCIER-À-VOUS"], "phenomena": ["connecteur", "directionnel"]}
{"text": "Elle n'aime pas du tout le café.", "language": "fr", "glosses": ["LUI", "CAFÉ", "AIMER", "NON"], "phenomena": ["negation", "pronom"]}
