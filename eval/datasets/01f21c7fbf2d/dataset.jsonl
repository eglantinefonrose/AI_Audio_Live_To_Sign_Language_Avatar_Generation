{"text": "Je t'explique la méthode.", "language": "fr", "glosses": ["MOI", "MÉTHODE", "EXPLIQUER-À-TOI"], "phenomena": ["directionnel", "verbe-final"]}
{"text": "Elle me prête son vélo.", "language": "fr", "glosses": ["LUI", "VÉLO", "LUI", "PRÊTER-À-MOI"], "phenomena": ["directionnel", "possession"]}
{"text": "Nous vous envoyons le rapport demain.", "language": "fr", "glosses": ["DEMAIN", "NOUS", "RAPPORT", "ENVOYER-À-VOUS"], "phenomena": ["directionnel", "temps"]}
{"text": "Tu lui as dit la vérité ?", "language": "fr", "glosses": ["AVANT", "TOI", "VÉRITÉ", "DIRE-À-LUI", "QUESTION"], "phenomena": ["directionnel", "temps-passe", "question-ouinon"]}
