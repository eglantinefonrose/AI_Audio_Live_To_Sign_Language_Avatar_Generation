<?xml version="1.0" encoding="utf-8"?>
<!--
  Lexique SiGML (HamNoSys 4 en XML, balises de sigmlhns.dtd, UEA).

  ⚠️ BROUILLONS NON VALIDÉS : descriptions rédigées par une IA (Claude), pas par
  un locuteur LSF. Elles servent à tester la chaîne SiGML -> animation, pas de
  référence. À faire relire et corriger par un signeur LSF.

  Main dominante = main droite. Directions vues du signeur : u haut, d bas,
  l gauche, r droite, o vers l'avant (loin du corps), i vers le corps.
  Orientation de la paume (hampalm*) : convention de sign_language_3d_avatar/avatar_animation/sigml_blender.py
  (voir README) ; à vérifier contre JASigning.
-->
<sigml>

  <!-- MOI : index pointé vers sa propre poitrine. -->
  <hns_sign gloss="MOI">
    <hamnosys_manual>
      <hamfinger2/> <hamextfingeri/> <hampalml/>
      <hamchest/> <hamclose/>
      <hammovei/> <hamsmallmod/>
    </hamnosys_manual>
  </hns_sign>

  <!-- TOI : index pointé vers l'interlocuteur, petit mouvement vers l'avant. -->
  <hns_sign gloss="TOI">
    <hamnosys_manual>
      <hamfinger2/> <hamextfingero/> <hampalml/>
      <hamneutralspace/>
      <hammoveo/> <hamsmallmod/>
    </hamnosys_manual>
  </hns_sign>

  <!-- MERCI : main plate, bout des doigts au menton, s'éloigne vers l'avant
       et le bas en finissant paume vers le haut. -->
  <hns_sign gloss="MERCI">
    <hamnosys_manual>
      <hamflathand/> <hamextfingeru/> <hampalmd/>
      <hamchin/> <hamtouch/>
      <hamparbegin/>
        <hammovedo/>
        <hamreplace/> <hamextfingero/> <hampalmu/>
      <hamparend/>
    </hamnosys_manual>
  </hns_sign>

  <!-- MAISON : deux mains plates en toit (symétrie gauche/droite), puis elles
       descendent en s'écartant et tracent les murs. -->
  <hns_sign gloss="MAISON">
    <hamnosys_manual>
      <hamsymmlr/>
      <hamflathand/> <hamextfingerul/> <hampalmdl/>
      <hamneutralspace/> <hamtouch/>
      <hammovedr/>
      <hammoved/> <hamsmallmod/>
      <hamreplace/> <hamextfingeru/> <hampalml/>
    </hamnosys_manual>
  </hns_sign>

  <!-- DONNER-À-TOI : main en bec, part de soi vers l'interlocuteur (arc). -->
  <hns_sign gloss="DONNER-À-TOI">
    <hamnosys_manual>
      <hampinchall/> <hamextfingero/> <hampalmu/>
      <hamchest/> <hamclose/>
      <hammoveo/> <hamarcu/> <hamlargemod/>
    </hamnosys_manual>
  </hns_sign>

  <!-- DONNER-À-MOI : même signe, direction inversée (de l'interlocuteur vers soi).
       Seuls l'emplacement de départ, la direction des doigts et le mouvement changent. -->
  <hns_sign gloss="DONNER-À-MOI">
    <hamnosys_manual>
      <hampinchall/> <hamextfingeri/> <hampalmu/>
      <hamneutralspace/>
      <hammovei/> <hamarcu/> <hamlargemod/>
    </hamnosys_manual>
  </hns_sign>

</sigml>
